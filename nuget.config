<?xml version="1.0" encoding="utf-8"?>
<!-- Restauration .NET déterministe : nuget.org seul, mappage explicite (NU1507 en gestion centrale des paquets,
     https://aka.ms/nuget-package-source-mapping). Le cache binaire vcpkg de la CI a son propre nuget.config (nugetconfig). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
