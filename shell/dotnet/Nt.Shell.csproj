<Project Sdk="Microsoft.NET.Sdk">
  <!-- docs/plan/01-stack.md « Profils .NET » ; Learn : Optimize AOT deployments, Native code interop with Native AOT -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <StackTraceSupport>true</StackTraceSupport>
  </PropertyGroup>

  <!-- RID .NET -> triplet Rust de la staticlib nt_ffi (`just ffi` la produit pour la même cible). -->
  <PropertyGroup>
    <NtRustTarget Condition="'$(RuntimeIdentifier)' == 'win-x64'">x86_64-pc-windows-msvc</NtRustTarget>
    <NtRustTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">aarch64-pc-windows-msvc</NtRustTarget>
    <NtRustTarget Condition="'$(RuntimeIdentifier)' == 'linux-x64'">x86_64-unknown-linux-gnu</NtRustTarget>
    <NtRustTarget Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">aarch64-unknown-linux-gnu</NtRustTarget>
    <NtRustTarget Condition="'$(RuntimeIdentifier)' == 'osx-x64'">x86_64-apple-darwin</NtRustTarget>
    <NtRustTarget Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">aarch64-apple-darwin</NtRustTarget>
    <NtFfiFile Condition="$(RuntimeIdentifier.StartsWith('win'))">nt_ffi.lib</NtFfiFile>
    <NtFfiFile Condition="!$(RuntimeIdentifier.StartsWith('win'))">libnt_ffi.a</NtFfiFile>
    <NtFfiLib>$(MSBuildThisFileDirectory)../../target/$(NtRustTarget)/release/$(NtFfiFile)</NtFfiLib>
    <!-- Baseline x86-64-v3 = minimum matériel du cahier des charges, x64 seulement. -->
    <IlcInstructionSet Condition="$(RuntimeIdentifier.EndsWith('-x64'))">x86-64-v3</IlcInstructionSet>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <DirectPInvoke Include="nt_ffi" />
    <NativeLibrary Include="$(NtFfiLib)" />
  </ItemGroup>

  <Target Name="NtCheckFfi" BeforeTargets="Build" Condition="'$(RuntimeIdentifier)' != '' and '$(PublishAot)' == 'true'">
    <Error Condition="'$(NtRustTarget)' == ''" Text="RID $(RuntimeIdentifier) non pris en charge par nt_ffi." />
    <Error Condition="!Exists('$(NtFfiLib)')" Text="$(NtFfiLib) absent : lancer `just ffi` pour ce RID." />
  </Target>
</Project>
